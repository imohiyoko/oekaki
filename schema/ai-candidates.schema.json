{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/imohiyoko/oekaki/main/schema/ai-candidates.schema.json",
  "title": "oekaki AI candidates",
  "type": "object",
  "required": ["kind", "version"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "oekaki.ai-candidates" },
    "version": { "type": "string", "minLength": 1 },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "name"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "provider": { "type": "string" }
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "relation"],
        "additionalProperties": false,
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "relation": { "type": "string", "minLength": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "note": { "type": "string" }
        }
      }
    },
    "needs": {
      "description": "Structured requests for repository or reference context that was not available to the model.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "identifier", "reason"],
        "additionalProperties": false,
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "identifier": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "repository_hint": { "type": "string" },
          "references": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
