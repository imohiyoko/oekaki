{
  "kind": "oekaki.overlay",
  "version": "0.1",
  "metadata": {
    "origin": "human",
    "author": "operator",
    "note": "everything the vocabulary can say, in one document",
    "window": "last-7d"
  },
  "sinks": [
    { "id": "sink.app", "type": "log_group", "name": "/platform/app" },
    { "id": "sink.audit", "type": "search_index", "name": "audit" },
    { "id": "sink.edge", "type": "object_prefix", "name": "logs/edge/" }
  ],
  "assertions": [
    { "assert": "logs.declared", "subject": { "node": "aws_ecs_service.api" },
      "sink": "sink.app", "stream": "api/*", "via": "task definition log driver" },
    { "assert": "logs.observed", "subject": { "service": "api" },
      "sink": "sink.app", "records": 128400 },
    { "assert": "logs.observed", "subject": { "load_balancer": "public" },
      "sink": "sink.edge", "records": 0 },
    { "assert": "logs.none", "subject": { "workload": "checkout", "namespace": "shop" },
      "via": "looked on the console and found nothing" },
    { "assert": "edge", "from": { "service": "checkout" }, "to": { "node": "aws_db_instance.orders" },
      "kind": "observed", "origin": "ai", "author": "assistant", "confidence": 0.6,
      "note": "read off a service map" },
    { "assert": "edge.suppress", "from": { "node": "aws_security_group.db" },
      "to": { "node": "aws_security_group.bastion" }, "kind": "iac_ref" },
    { "assert": "node", "subject": { "id": "vendor.payments" },
      "type": "external_service", "name": "payments gateway" }
  ]
}
