# Normalise to LF everywhere.
#
# This is not cosmetic. Generated output is byte-for-byte reproducible and CI
# fails if regenerating the example changes it; if Windows checkouts got CRLF,
# a contributor there would see a diff for every generated file and the
# determinism guarantee would look broken when it is not.
* text=auto eol=lf

# Generated by `make example`. Collapsed in diffs and excluded from language
# statistics, since neither reflects hand-written work.
examples/three-tier/graph.json        linguist-generated=true
examples/three-tier/architecture.svg  linguist-generated=true
examples/three-tier/architecture.mmd  linguist-generated=true

# A real `terraform show -json` capture, not something anyone edits by hand.
examples/three-tier/plan.json         linguist-generated=true

# Generated by `make example`. The report is in here deliberately: it puts the
# deliberately-unmatched and deliberately-ambiguous subjects into the CI diff,
# so a regression that starts dropping evidence silently breaks the build.
examples/log-coverage/graph.json    linguist-generated=true
examples/log-coverage/report.json   linguist-generated=true
examples/log-coverage/coverage.svg  linguist-generated=true
examples/log-coverage/coverage.mmd  linguist-generated=true
examples/log-coverage/coverage.html linguist-generated=true
examples/log-coverage/plan.json     linguist-generated=true

